# Copy to .env and fill in. NEVER commit .env.
OPENALGO_BASE_URL=http://127.0.0.1:5000
OPENALGO_API_KEY=
QUOTE_FETCH_DELAY_MS=400

# Email alerts (SMTP over SSL). If unset, alerts are written to data/outbox/ instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_TO=

# Paths (defaults shown)
# PM_HOLDINGS_PATH=data/holdings.xlsx
# PM_MEMORY_PATH=data/memory.json

# Rules
PM_DAY_MOVE_PCT=5
PM_REALERT_PCT=3
PM_VOL_SPIKE=2.5
PM_CYCLE_MIN=15
# PM_EXTRA_HOLIDAYS=2026-12-31

# Dashboard (server: PM_DASH_HOST=0.0.0.0 and a long random token are required)
PM_DASH_HOST=127.0.0.1
PM_DASH_TOKEN=
